#!/usr/bin/env bash
#
# devnull: post to /dev/null (https://dev-null.sh) without remembering the curl incantation.
#
#   devnull It was DNS.                     plain commit (quotes optional)
#   devnull -r 0be0130 Agreed!              reply to a commit
#   devnull ~/Desktop/shipped.png Shipped!  drag images anywhere into the command (up to 3)
#   devnull                                 interactive: drop images, then type the message
#
# Any argument that is an existing .png/.jpg/.jpeg/.webp/.heic/.heif file is attached as an
# image; everything else becomes the message. HEIC/HEIF is converted to JPEG and anything over
# 1600px is scaled down first (via sips on macOS, ImageMagick elsewhere).
#
# Written for the bash 3.2 that ships with macOS.

MAX_SIDE=1600

usage() {
  echo "usage: devnull [-r|--reply <hash>] [image ...] [message ...]" >&2
  exit 1
}

fail() {
  echo "devnull: $*" >&2
  exit 1
}

lower() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

is_image() {
  [ -f "$1" ] || return 1
  case "$(lower "$1")" in
    *.png | *.jpg | *.jpeg | *.webp | *.heic | *.heif) return 0 ;;
    *) return 1 ;;
  esac
}

# The tool that reads and writes images: sips on macOS, ImageMagick (7, then 6) elsewhere.
if command -v sips > /dev/null; then
  image_tool=sips
elif command -v magick > /dev/null; then
  image_tool=magick
elif command -v convert > /dev/null && command -v identify > /dev/null; then
  image_tool=imagemagick6
else
  image_tool=""
fi

# Prints the longest side of an image in pixels, or 0 when it can't be read.
longest_side() {
  case "$image_tool" in
    sips) sips -g pixelWidth -g pixelHeight "$1" 2> /dev/null | awk '/pixel(Width|Height)/ { print $2 }' ;;
    magick) magick identify -format '%w\n%h\n' "$1[0]" 2> /dev/null ;;
    imagemagick6) identify -format '%w\n%h\n' "$1[0]" 2> /dev/null ;;
  esac | awk '{ if ($1 > max) max = $1 } END { print max + 0 }'
}

# convert_image <source> <output> <png|jpeg> <scale down: 0|1>
convert_image() {
  local args
  case "$image_tool" in
    sips)
      args=(-s format "$3")
      [ "$3" = jpeg ] && args+=(-s formatOptions 85)
      [ "$4" -eq 1 ] && args+=(-Z "$MAX_SIDE")
      sips "${args[@]}" "$1" --out "$2"
      ;;
    magick | imagemagick6)
      args=("$1[0]" -auto-orient)
      [ "$4" -eq 1 ] && args+=(-resize "${MAX_SIDE}x${MAX_SIDE}>")
      [ "$3" = jpeg ] && args+=(-quality 85)
      if [ "$image_tool" = magick ]; then
        magick "${args[@]}" "$2"
      else
        convert "${args[@]}" "$2"
      fi
      ;;
    *) return 1 ;;
  esac > /dev/null 2>&1
}

reply=""
images=()
words=()

while [ $# -gt 0 ]; do
  case "$1" in
    -r | --reply) [ -n "${2:-}" ] || usage; reply=$2; shift 2 ;;
    -i | --image) [ -n "${2:-}" ] || usage; images+=("$2"); shift 2 ;;
    -h | --help) usage ;;
    --) shift; words+=("$@"); break ;;
    *)
      if is_image "$1"; then
        images+=("$1")
      else
        words+=("$1")
      fi
      shift
      ;;
  esac
done

# No message given: ask for one, and offer to take dropped images first.
if [ ${#words[@]} -eq 0 ]; then
  if [ ${#images[@]} -eq 0 ]; then
    read -r -p "Drop images (Enter to skip): " dropped < /dev/tty
    # Terminals paste dropped files shell-escaped (\ or quotes). xargs splits and unquotes them
    # the same way, without ever executing the pasted text.
    while IFS= read -r dropped_path; do
      if is_image "$dropped_path"; then
        images+=("$dropped_path")
      else
        echo "devnull: skipping $dropped_path (not a .png, .jpg, .webp or .heic file)" >&2
      fi
    done < <(printf '%s' "$dropped" | xargs -n 1 printf '%s\n')
  fi
  read -r -p "Message: " message < /dev/tty
  words=("$message")
fi

[ ${#images[@]} -le 3 ] || fail "up to 3 images per commit."

# /dev/null only takes JPEG, PNG and WebP and rejects large dimensions: convert HEIC/HEIF to
# JPEG and scale anything over MAX_SIDE px down, in a throwaway directory. Originals stay untouched.
tmp_dir=""
for i in "${!images[@]}"; do
  src=${images[$i]}
  src_lower=$(lower "$src")

  longest=$(longest_side "$src")

  case "$src_lower" in
    *.heic | *.heif) is_heic=1 ;;
    *) is_heic=0 ;;
  esac
  [ "$is_heic" -eq 1 ] || [ "$longest" -gt "$MAX_SIDE" ] || continue

  [ -n "$image_tool" ] || fail "$src is HEIC/HEIF: install ImageMagick so it can be converted to JPEG."

  if [ -z "$tmp_dir" ]; then
    tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/devnull-img.XXXXXX") || exit 1
    trap 'rm -rf -- "$tmp_dir"' EXIT
  fi

  # Keep PNG as PNG (screenshots, transparency); everything else becomes JPEG.
  name=$(basename "$src")
  name=${name%.*}
  case "$src_lower" in
    *.png) format=png; out="$tmp_dir/$i-$name.png" ;;
    *) format=jpeg; out="$tmp_dir/$i-$name.jpg" ;;
  esac
  scale_down=0
  [ "$longest" -gt "$MAX_SIDE" ] && scale_down=1

  if ! convert_image "$src" "$out" "$format" "$scale_down"; then
    [ "$is_heic" -eq 1 ] && [ "$image_tool" != sips ] \
      && fail "could not convert $src: your ImageMagick may lack HEIC support (libheif)."
    fail "could not prepare $src for upload."
  fi
  images[$i]=$out
done

args=()
[ -n "$reply" ] && args+=(--reply "$reply")
for image in ${images[@]+"${images[@]}"}; do
  args+=(--image "$image")
done
args+=(-- "${words[*]}")

curl -fsSL https://dev-null.sh/commit | bash -s -- "${args[@]}"
