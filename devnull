#!/usr/bin/env bash
#
# devnull: post to /dev/null (https://dev-null.sh) without remembering the curl incantation.
#
#   devnull It was DNS.                     plain commit (quotes optional)
#   devnull -r 0be0130 Agreed!              reply to a commit
#   devnull ~/Desktop/shipped.png Shipped!  drag images anywhere into the command (up to 3)
#   devnull -c Shipped!                     attach the screenshot on the clipboard (WSL)
#   devnull                                 interactive: drop images, then type the message
#
# Any argument that is an existing .png/.jpg/.jpeg/.webp/.heic/.heif file is attached as an
# image; everything else becomes the message. HEIC/HEIF is converted to JPEG and anything over
# 1600px is scaled down first (via sips on macOS, ImageMagick elsewhere).
#
# Under WSL, interactive mode also offers to attach a screenshot found on the Windows clipboard.
#
# Written for the bash 3.2 that ships with macOS.

MAX_SIDE=1600

usage() {
  echo "usage: devnull [-r|--reply <hash>] [-c|--clipboard] [image ...] [message ...]" >&2
  exit 1
}

fail() {
  echo "devnull: $*" >&2
  exit 1
}

lower() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

is_image() {
  [ -f "$1" ] || return 1
  case "$(lower "$1")" in
    *.png | *.jpg | *.jpeg | *.webp | *.heic | *.heif) return 0 ;;
    *) return 1 ;;
  esac
}

# Windows Terminal pastes Windows paths, usually quoted ("C:\Users\me\shot.png"). Strip leftover
# quotes and, under WSL, translate the path to its Linux form (/mnt/c/Users/me/shot.png).
local_path() {
  local path=$1
  case "$path" in
    \"*\" | \'*\') path=${path:1:${#path}-2} ;;
  esac
  case "$path" in
    [A-Za-z]:\\* | [A-Za-z]:/* | \\\\*)
      command -v wslpath > /dev/null && path=$(wslpath -u "$path" 2> /dev/null || printf '%s' "$path")
      ;;
  esac
  printf '%s' "$path"
}

# The tool that reads and writes images: sips on macOS, ImageMagick (7, then 6) elsewhere.
if command -v sips > /dev/null; then
  image_tool=sips
elif command -v magick > /dev/null; then
  image_tool=magick
elif command -v convert > /dev/null && command -v identify > /dev/null; then
  image_tool=imagemagick6
else
  image_tool=""
fi

# Prints the longest side of an image in pixels, or 0 when it can't be read.
longest_side() {
  case "$image_tool" in
    sips) sips -g pixelWidth -g pixelHeight "$1" 2> /dev/null | awk '/pixel(Width|Height)/ { print $2 }' ;;
    magick) magick identify -format '%w\n%h\n' "$1[0]" 2> /dev/null ;;
    imagemagick6) identify -format '%w\n%h\n' "$1[0]" 2> /dev/null ;;
  esac | awk '{ if ($1 > max) max = $1 } END { print max + 0 }'
}

# convert_image <source> <output> <png|jpeg> <scale down: 0|1>
convert_image() {
  local args
  case "$image_tool" in
    sips)
      args=(-s format "$3")
      [ "$3" = jpeg ] && args+=(-s formatOptions 85)
      [ "$4" -eq 1 ] && args+=(-Z "$MAX_SIDE")
      sips "${args[@]}" "$1" --out "$2"
      ;;
    magick | imagemagick6)
      args=("$1[0]" -auto-orient)
      [ "$4" -eq 1 ] && args+=(-resize "${MAX_SIDE}x${MAX_SIDE}>")
      [ "$3" = jpeg ] && args+=(-quality 85)
      if [ "$image_tool" = magick ]; then
        magick "${args[@]}" "$2"
      else
        convert "${args[@]}" "$2"
      fi
      ;;
    *) return 1 ;;
  esac > /dev/null 2>&1
}

# Throwaway directory for converted images, removed on exit. Created on first use.
tmp_dir=""
make_tmp_dir() {
  [ -z "$tmp_dir" ] || return 0
  tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/devnull-img.XXXXXX") || exit 1
  trap 'rm -rf -- "$tmp_dir"' EXIT
}

# Saves the screenshot on the Windows clipboard to $tmp_dir/clipboard.png, scaled down to
# MAX_SIDE px so it needs no ImageMagick, and fails when the clipboard holds no image. WSL only.
# Windows Terminal swallows Ctrl+V when the clipboard holds an image instead of text, so the
# paste never reaches us: we have to go and look.
clipboard_image() {
  command -v powershell.exe > /dev/null || return 1
  make_tmp_dir
  powershell.exe -NoProfile -NonInteractive -STA -Command '
    Add-Type -AssemblyName System.Windows.Forms, System.Drawing
    $img = [System.Windows.Forms.Clipboard]::GetImage()
    if (-not $img) { exit 1 }
    $scale = '"$MAX_SIDE"' / [Math]::Max($img.Width, $img.Height)
    if ($scale -lt 1) {
      $small = New-Object System.Drawing.Bitmap ([int]($img.Width * $scale)), ([int]($img.Height * $scale))
      $g = [System.Drawing.Graphics]::FromImage($small)
      $g.InterpolationMode = [System.Drawing.Drawing2D.InterpolationMode]::HighQualityBicubic
      $g.DrawImage($img, 0, 0, $small.Width, $small.Height)
      $img = $small
    }
    $png = New-Object System.IO.MemoryStream
    $img.Save($png, [System.Drawing.Imaging.ImageFormat]::Png)
    [Convert]::ToBase64String($png.ToArray())
  ' < /dev/null 2> /dev/null | tr -d '\r' | base64 -d > "$tmp_dir/clipboard.png" 2> /dev/null
  [ -s "$tmp_dir/clipboard.png" ]
}

reply=""
from_clipboard=0
images=()
words=()

while [ $# -gt 0 ]; do
  case "$1" in
    -r | --reply) [ -n "${2:-}" ] || usage; reply=$2; shift 2 ;;
    -c | --clipboard) from_clipboard=1; shift ;;
    -i | --image) [ -n "${2:-}" ] || usage; images+=("$(local_path "$2")"); shift 2 ;;
    -h | --help) usage ;;
    --) shift; words+=("$@"); break ;;
    *)
      path=$(local_path "$1")
      if is_image "$path"; then
        images+=("$path")
      else
        words+=("$1")
      fi
      shift
      ;;
  esac
done

if [ "$from_clipboard" -eq 1 ]; then
  clipboard_image || fail "no screenshot on the clipboard (only supported under WSL)."
  images+=("$tmp_dir/clipboard.png")
fi

# No message given: ask for one, and offer to take a clipboard screenshot or dropped images first.
if [ ${#words[@]} -eq 0 ]; then
  if [ ${#images[@]} -eq 0 ] && clipboard_image; then
    read -r -p "Attach the screenshot on your clipboard? [Y/n] " answer < /dev/tty
    case "$(lower "$answer")" in
      n | no) ;;
      *) images+=("$tmp_dir/clipboard.png") ;;
    esac
  fi
  if [ ${#images[@]} -eq 0 ]; then
    read -r -p "Drop images (Enter to skip): " dropped < /dev/tty
    # Terminals paste dropped files shell-escaped (\ or quotes). xargs splits and unquotes them
    # the same way, without ever executing the pasted text.
    while IFS= read -r dropped_path; do
      # GNU xargs runs once even for empty input, handing us an empty line.
      [ -n "$dropped_path" ] || continue
      dropped_path=$(local_path "$dropped_path")
      if is_image "$dropped_path"; then
        images+=("$dropped_path")
      else
        echo "devnull: skipping $dropped_path (not a .png, .jpg, .webp or .heic file)" >&2
      fi
    done < <(printf '%s' "$dropped" | xargs -n 1 printf '%s\n')
  fi
  read -r -p "Message: " message < /dev/tty
  words=("$message")
fi

[ ${#images[@]} -le 3 ] || fail "up to 3 images per commit."

# /dev/null only takes JPEG, PNG and WebP and rejects large dimensions: convert HEIC/HEIF to
# JPEG and scale anything over MAX_SIDE px down, in a throwaway directory. Originals stay untouched.
for i in "${!images[@]}"; do
  src=${images[$i]}
  src_lower=$(lower "$src")

  longest=$(longest_side "$src")

  case "$src_lower" in
    *.heic | *.heif) is_heic=1 ;;
    *) is_heic=0 ;;
  esac
  [ "$is_heic" -eq 1 ] || [ "$longest" -gt "$MAX_SIDE" ] || continue

  [ -n "$image_tool" ] || fail "$src is HEIC/HEIF: install ImageMagick so it can be converted to JPEG."

  make_tmp_dir

  # Keep PNG as PNG (screenshots, transparency); everything else becomes JPEG.
  name=$(basename "$src")
  name=${name%.*}
  case "$src_lower" in
    *.png) format=png; out="$tmp_dir/$i-$name.png" ;;
    *) format=jpeg; out="$tmp_dir/$i-$name.jpg" ;;
  esac
  scale_down=0
  [ "$longest" -gt "$MAX_SIDE" ] && scale_down=1

  if ! convert_image "$src" "$out" "$format" "$scale_down"; then
    [ "$is_heic" -eq 1 ] && [ "$image_tool" != sips ] \
      && fail "could not convert $src: your ImageMagick may lack HEIC support (libheif)."
    fail "could not prepare $src for upload."
  fi
  images[$i]=$out
done

args=()
[ -n "$reply" ] && args+=(--reply "$reply")
for image in ${images[@]+"${images[@]}"}; do
  args+=(--image "$image")
done
args+=(-- "${words[*]}")

curl -fsSL https://dev-null.sh/commit | bash -s -- "${args[@]}"
